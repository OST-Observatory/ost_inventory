[Unit]
Description=OST Inventory gunicorn daemon
Requires=ost-inventory.socket
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/ost_inventory
EnvironmentFile=/opt/ost_inventory/.env
Environment=DJANGO_ENV=production
ExecStart=/opt/ost_inventory/.venv/bin/gunicorn \
    --workers 3 \
    --timeout 120 \
    --bind unix:/run/ost-inventory/gunicorn.sock \
    config.wsgi:application
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
MemoryMax=512M
ReadWritePaths=/opt/ost_inventory/media /opt/ost_inventory/logs /run/ost-inventory

[Install]
WantedBy=multi-user.target
