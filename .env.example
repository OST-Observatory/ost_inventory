# Copy to .env and chmod 600. Never deploy this file with production secrets
# inside the git/release tree; keep production env owned by the service user.

SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_ENV=development

# Production database (ignored in development / SQLite)
DATABASE_NAME=ost_inventory
DATABASE_USER=ost_inventory
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Use verify-full (plus a CA) for remote PostgreSQL.
DATABASE_SSLMODE=prefer

ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_ORIGIN=https://example.example
FORCE_SCRIPT_NAME=
# Shared vhost at https://host/inventory/ — set this to /inventory (not empty).
# Dedicated vhost (app owns the hostname) — leave empty.
# Production default is True; keep False only for local HTTP.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
DEFAULT_FROM_EMAIL=inventory@example.com
# console (default in development when EMAIL_HOST is empty), smtp, or sendmail
EMAIL_METHOD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
EMAIL_SENDMAIL=/usr/sbin/sendmail

# LDAP — leave LDAP_SERVER_URI empty for local ModelBackend-only auth.
# Production forbids ldap:// without STARTTLS; prefer ldaps://.
LDAP_SERVER_URI=
LDAP_START_TLS=True
LDAP_DEBUG=False
LDAP_TLS_CACERT=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_GROUP_SEARCH_BASE=
LDAP_USER_FILTER=
LDAP_CONNECT_TIMEOUT=5
LDAP_GROUP_STAFF_DN=
LDAP_GROUP_SUPERUSER_DN=
LDAP_GROUP_SUPERVISOR_DN=
LDAP_GROUP_STUDENT_DN=
